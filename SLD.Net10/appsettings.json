{
  // 程序监听地址配置，0.0.0.0 允许局域网/外网访问，多地址用分号分隔
  "Urls": "https://0.0.0.0:9666",
  // 日志配置根节点
  "Logging": {
    // 日志分级配置
    "LogLevel": {
      // 全局默认日志打印等级：Information 输出常规业务日志
      "Default": "Information",
      // 单独控制AspNetCore框架日志等级，仅输出警告及以上日志，过滤大量框架冗余信息
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // 跨域主机白名单，* 代表允许任意客户端域名访问接口
  "AllowedHosts": "*",
  // 数据库连接字符串配置组
  "ConnectionStrings": {
    // PostgreSQL 数据库默认连接参数
    "Default": "PORT=5432;DATABASE=SLD_Net10_Test;HOST=localhost;PASSWORD=11;USER ID=postgres"
  },
  "MqttConfigs": [
    {
      "ClientId": "LocalMqttService",
      "ServerIp": "192.168.20.115",
      "Port": 1883,
      "UserName": "",
      "Password": "",
      "CleanSession": true,
      "KeepAliveSecond": 60
    }
  ],
  "ModbusRtuDevices": [
    {
      "DeviceCode": "PressMachine01",
      "IpAddress": "192.168.5.1",
      "Port": 8899,
      "SlaveId": 1,
      "TimeoutMs": 2000,
      "WaitResponse": true
    }
  ]

}